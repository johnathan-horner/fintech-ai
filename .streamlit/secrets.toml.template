# .streamlit/secrets.toml  (never commit the real file - it is gitignored)
# Locally, Streamlit also reads ~/.streamlit/secrets.toml.
# On Streamlit Cloud paste this into App settings -> Secrets.
# Without a key the app runs in demo mode (quant metrics live, AI sections
# show deterministic data-derived templates).

# Primary provider: Amazon Bedrock Claude Haiku 4.5. On Streamlit ONLY these keys are used
# (no fallthrough to instance or other credentials). Omit the section to skip Bedrock.
[aws]
access_key_id = "your-access-key-id"
secret_access_key = "your-secret-access-key"
region = "us-east-1"

# Fallback provider (and required for gemini-embedding-001 retrieval)
[gemini]
# Google AI Studio API key on a project with NO billing attached (free tier only).
api_key = "your-gemini-api-key"

# Optional
[llm]
# Provider order (default "bedrock,gemini"; demo mode is always last)
# providers = "bedrock,gemini"
# Optional Gemini per-role model overrides (defaults in src/llm/config.py). Changing a model
# id blocks live use until scripts/run_eval.py re-approves that exact version.
# chat_model = "gemini-3.5-flash-lite"
# grader_model = "gemini-3.1-flash-lite"
# hyde_model = "gemini-3.1-flash-lite"
# embedding_model = "gemini-embedding-001"
